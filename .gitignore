# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment / secrets
.env
.env.*
!.env.example
*.key
credentials.json

# IDE / editor
.vscode/
.idea/
*.swp
.DS_Store

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Notebooks
.ipynb_checkpoints/

# Project data / artifacts
*.log
data/
*.db
*.sqlite3

# RAG vector store — derived, rebuildable LanceDB artifact; never committed
.rag-index/

# Claude Code — keep settings.json tracked, ignore personal/session files
.claude/settings.local.json
.claude/STATE.md

# Vault activity log — tracked in git per log-schema.md (audit trail alongside commits)
log/*
!log/.gitkeep

# Obsidian App-generated scratch files at vault root (daily notes, empty canvas/base)
/*.canvas
/*.base
/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].md

# Notion import — temporary staging dir for bulk migration; never committed
.import-staging/

# Obsidian — per-vault config is machine-specific; don't impose it on cloners
.obsidian/

# Vault sources — original files (PDFs etc.); kept locally + vault-synced, not in git
Sources/*
!Sources/.gitkeep

# Personal captured notes — kept locally only, never pushed to the public repo
note-ignore/
